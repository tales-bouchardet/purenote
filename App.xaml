<Application x:Class="PureNote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">pack://application:,,,/font/#DM Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/font/#DM Mono</FontFamily>

            <SolidColorBrush x:Key="Accent" Color="#FEB12E"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#6A4A12"/>

            <Color x:Key="SystemAccentColor">#FEB12E</Color>
            <Color x:Key="SystemAccentColorPrimary">#FFC257</Color>
            <Color x:Key="SystemAccentColorSecondary">#FEB12E</Color>
            <Color x:Key="SystemAccentColorTertiary">#D9930F</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#FEB12E"/>
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#FFC257"/>
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FEB12E"/>
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#D9930F"/>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FEB12E"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#EBA328"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9930F"/>
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FEB12E"/>

            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FEB12E"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFC257"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFD48A"/>

            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#D9930F"/>

            <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="ChromeBackground" Color="#252526"/>
            <SolidColorBrush x:Key="PopupBackground" Color="#2D2D30"/>
            <SolidColorBrush x:Key="HoverBackground" Color="#3E3E42"/>

            <SolidColorBrush x:Key="PanelBorder" Color="#3F3F46"/>
            <SolidColorBrush x:Key="ChromeBorder" Color="#333337"/>

            <SolidColorBrush x:Key="PrimaryText" Color="White"/>
            <SolidColorBrush x:Key="EditorText" Color="#D4D4D4"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#9A9A9A"/>
            <SolidColorBrush x:Key="MutedText" Color="Gray"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
