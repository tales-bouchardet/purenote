<ui:FluentWindow x:Class="PureNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PureNote"
        Title="purenote" Height="600" Width="800"
        Icon="icon.ico"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        Background="{StaticResource WindowBackground}"
        Closing="Window_Closing"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
    <ui:FluentWindow.Resources>
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource EditorText}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>

            <!-- A horizontal StackPanel rather than the WrapPanel a Menu uses by
                 default, because a StackPanel stretches its children across the
                 other axis and a WrapPanel leaves them at their desired size.
                 That is what makes the items fill the height of the bar - which
                 is not only how the bar looks right, but where its dropdowns
                 open from: a Popup placed below a centred item opens ten pixels
                 up inside the bar. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The surface a dropdown is drawn on. The margin is there for the
             shadow to fall into: a popup with AllowsTransparency can draw
             outside its content, but only into space the content has left it.
             It costs nothing in placement - a Popup positions its child's
             content, not its margin box, so the visible border still lands on
             the placement point and no offset is needed to put it back. -->
        <Style x:Key="MenuSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PopupBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="10,2,10,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top of the bar: File, View, Find, Replace. Nothing but a label and a
             fill behind it, tight enough that the four of them read as one strip
             rather than as four buttons.

             They sit back at rest and come forward under the pointer. The colour
             is set here on the Border rather than on the MenuItem so it reaches
             the label by inheritance and stays out of the way of the submenu
             template, which wants its own. Note that a Foreground written on the
             MenuItem in the markup would outrank all of this - which is why the
             four of them no longer carry one. -->
        <ControlTemplate x:Key="TopLevelMenuItemTemplate" TargetType="MenuItem">
            <!-- The margin is on this Border and deliberately not on the MenuItem.
                 The item still measures the full height of the bar, which is what
                 the dropdown is placed against; only the fill behind the label
                 pulls in from the edges. Putting it on the item instead would
                 shorten the item and send the menu back to opening inside the
                 bar. -->
            <Border x:Name="Fill" Background="{TemplateBinding Background}" Padding="9,4"
                    Margin="0,4" CornerRadius="4"
                    TextElement.Foreground="{StaticResource SecondaryText}">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>

                    <!-- Anchored to the MenuItem itself. Left to itself a Popup
                         inside a template anchors to its own parent in the visual
                         tree - here the Grid, which sits inside the Border's
                         padding - so the menu opened a padding's worth up and to
                         the side of where it looked like it should.

                         No offsets: with the item filling the bar and the target
                         named, the placement point is already the item's
                         bottom-left corner and the dropdown hangs flush off the
                         bar. -->
                    <Popup x:Name="PART_Popup"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Style="{StaticResource MenuSurfaceStyle}">
                            <StackPanel IsItemsHost="True" Orientation="Vertical"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource HoverBackground}"/>
                    <Setter TargetName="Fill" Property="TextElement.Foreground" Value="{StaticResource PrimaryText}"/>
                </Trigger>

                <!-- Held bright for as long as the menu is down, so the one that
                     is open is the one that looks open. -->
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource HoverBackground}"/>
                    <Setter TargetName="Fill" Property="TextElement.Foreground" Value="{StaticResource PrimaryText}"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Fill" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Fill" Property="TextElement.Foreground" Value="{StaticResource MutedText}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Inside a dropdown, and inside the editor's context menu.
             Four columns, and the two on the outside are a fixed width on
             purpose: a check gutter that sizes to its contents is empty until
             something is ticked, and then every label on the menu jumps sideways.
             The third column is the shortcut, right up against the chevron
             column, which is the part that makes a menu read as a real one. -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <!-- A shade back from white at rest, white under the pointer, the
                 same way the bar behaves. Not as far back as the bar items: these
                 are the thing being read, not a label waiting to be pointed at. -->
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    TextElement.Foreground="{StaticResource EditorText}">
                <Grid MinHeight="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                    </Grid.ColumnDefinitions>

                    <Path x:Name="CheckMark" Grid.Column="0" Visibility="Collapsed"
                          Data="M0,4 L3,7 L8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>

                    <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                               Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="28,0,0,0"/>

                    <Path x:Name="SubmenuArrow" Grid.Column="3" Visibility="Collapsed"
                          Data="M0,0 L4,4 L0,8" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Same anchoring. The five it comes up by is the surface's
                         own border and padding: a submenu reads as attached when
                         its first item lines up with the item that opened it, not
                         when its frame does. -->
                    <Popup x:Name="PART_Popup"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Right" VerticalOffset="-5"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Style="{StaticResource MenuSurfaceStyle}">
                            <StackPanel IsItemsHost="True" Orientation="Vertical"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource HoverBackground}"/>
                    <Setter TargetName="Fill" Property="TextElement.Foreground" Value="{StaticResource PrimaryText}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                </Trigger>

                <!-- Last, so it wins over IsHighlighted: a disabled item that
                     still lights up under the pointer reads as clickable. The
                     shortcut greys out with the label, or it goes on looking
                     available next to something that is not. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Fill" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Fill" Property="TextElement.Foreground" Value="{StaticResource MutedText}"/>
                    <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource PanelBorder}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Which of the two an item gets is decided by where it sits, which is
             what MenuItem.Role reports. The default covers TopLevelItem - Find
             and Replace, which are on the bar but open nothing. -->
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The context menu is hosted in its own popup rather than in the window,
             so it inherits none of the window's chrome and has to be dressed
             itself or it opens as a light-themed strip over a dark editor. -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="{StaticResource PopupBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- The same surface a dropdown gets, so the menu the
                             editor opens and the menus the bar opens are the same
                             object seen twice rather than two near-misses. -->
                        <Border Style="{StaticResource MenuSurfaceStyle}">
                            <StackPanel IsItemsHost="True" Orientation="Vertical"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyed on SeparatorStyleKey rather than by type: menus look their
             separators up under that key, so a plain TargetType style would be
             ignored and the default light rule drawn instead. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <!-- Runs almost the full width of the menu, with only
                             enough air above and below to group what it divides. -->
                        <Rectangle Height="1" Margin="1,4" Fill="{StaticResource PanelBorder}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopBarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="{StaticResource PanelBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="FooterSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{StaticResource PanelBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <!-- The caption buttons, to the measurements Windows uses for its own:
             46 units wide, the full height of the bar so they meet the top edge,
             no gap between them and no rounding. The glyphs are the ones the
             shell draws - Segoe Fluent Icons on Windows 11, falling back to the
             Segoe MDL2 Assets of Windows 10 - rather than the em dash and
             multiplication sign that were standing in for them, which is most of
             what made the old ones read as hand-drawn. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>

            <!-- Held back at rest and brought forward under the pointer, the same
                 as the menu items across the bar from them. The close button
                 inherits this and paints its own white over the red. -->
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource HoverBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource PanelBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Set in the style rather than on the button, because a value written
             on the element itself would outrank the trigger below and the glyph
             would never change back. -->
        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The one caption button Windows colours: red on hover, lighter while
             held, and the glyph stays white through both. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#C84031"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed"/>
        <CommandBinding Command="ApplicationCommands.Replace" Executed="Replace_Executed"/>
    </ui:FluentWindow.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ChromeBackground}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="10,0,0,0">

                <!-- DecodePixelWidth picks the 16-pixel frame out of the icon
                     rather than taking the largest one and shrinking it, which is
                     what makes a multi-size .ico look soft at this size. It
                     handles no mouse events, so the click still reaches the bar
                     underneath and the window can be dragged by its icon. -->
                <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="icon.ico" DecodePixelWidth="16"/>
                    </Image.Source>
                </Image>

                <Menu Background="Transparent">
                    <MenuItem Header="File">
                        <MenuItem Header="New" Click="New_Click" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="Open" Click="Open_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Save" Click="Save_Click" InputGestureText="Ctrl+S"/>
                        <MenuItem Header="Save As..." Click="SaveAs_Click"/>
                        <Separator/>
                        <MenuItem x:Name="EncodingMenu" Header="Encoding">
                            <MenuItem Header="UTF-8" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="UTF-8 BOM" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="UTF-16 LE" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="UTF-16 BE" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="UTF-32 LE" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="UTF-32 BE" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="ASCII" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="Windows-1252" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                            <MenuItem Header="ISO-8859-1" IsCheckable="True" Click="EncodingMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="LineEndingMenu" Header="Line endings">
                            <MenuItem Header="CRLF" IsCheckable="True" Click="LineEndingMenuItem_Click"/>
                            <MenuItem Header="LF" IsCheckable="True" Click="LineEndingMenuItem_Click"/>
                            <MenuItem Header="CR" IsCheckable="True" Click="LineEndingMenuItem_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Info" Click="Info_Click"/>
                    </MenuItem>
                </Menu>

                <Rectangle Style="{StaticResource TopBarSeparatorStyle}"/>

                <Menu Background="Transparent">
                    <MenuItem Header="View">
                        <MenuItem x:Name="LineNumbersMenuItem" Header="Line numbers" IsCheckable="True" Click="LineNumbersMenuItem_Click"/>
                    </MenuItem>
                </Menu>

                <Rectangle Style="{StaticResource TopBarSeparatorStyle}"/>

                <Menu Background="Transparent">
                    <MenuItem x:Name="FindMenu" Header="Find" Click="Find_Click"/>
                    <MenuItem x:Name="ReplaceMenu" Header="Replace" Click="Replace_Click"/>
                </Menu>

                <!-- The separator that used to stand between the menus and the
                     file name went with the file name. The popups below take no
                     room in this row - they are their own windows - so leaving it
                     put a divider after the last menu with nothing beyond it. -->

                <Popup x:Name="FindPopup" PlacementTarget="{Binding ElementName=FindMenu}" Placement="Bottom"
                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                        <Grid Width="260">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" x:Name="FindHeader" Background="{StaticResource ChromeBackground}" CornerRadius="8,8,0,0" Height="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Find" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Button Grid.Column="1" Content="✕" Click="FindClose_Click" Width="34"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedText}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="12">
                                <TextBox x:Name="FindTextBox" Padding="6,4"
                                         Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                         TextChanged="FindTextBox_TextChanged" KeyDown="FindTextBox_KeyDown"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="▲ Up" Click="FindPrevious_Click" Padding="8,4" Margin="0,0,6,0"/>
                                    <Button Content="▼ Down" Click="FindNext_Click" Padding="8,4"/>
                                </StackPanel>

                                <CheckBox x:Name="HighlightAllCheck" Content="Highlight matches" Foreground="{StaticResource PrimaryText}"
                                          Padding="0" Margin="0,10,0,0"
                                          Checked="HighlightOption_Changed" Unchecked="HighlightOption_Changed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="SimplifiedMatchRadio" Content="Simple" GroupName="FindMode"
                                                 Foreground="{StaticResource PrimaryText}" Checked="MatchMode_Changed"/>
                                    <RadioButton x:Name="ExactMatchRadio" Content="Exact" GroupName="FindMode"
                                                 Foreground="{StaticResource PrimaryText}" Margin="14,0,0,0" Checked="MatchMode_Changed"/>
                                </StackPanel>

                                <TextBlock x:Name="FindStatusText" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <Popup x:Name="ReplacePopup" PlacementTarget="{Binding ElementName=ReplaceMenu}" Placement="Bottom"
                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                        <Grid Width="260">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" x:Name="ReplaceHeader" Background="{StaticResource ChromeBackground}" CornerRadius="8,8,0,0" Height="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Replace" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Button Grid.Column="1" Content="✕" Click="ReplaceClose_Click" Width="34"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedText}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="12">
                                <TextBlock Text="Find" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplaceFindTextBox" Padding="6,4"
                                         Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                         KeyDown="ReplaceTextBox_KeyDown"/>

                                <TextBlock Text="Replace with" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,4"/>
                                <TextBox x:Name="ReplaceWithTextBox" Padding="6,4"
                                         Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                         KeyDown="ReplaceTextBox_KeyDown"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Replace" Click="ReplaceNext_Click" Padding="8,4" Margin="0,0,6,0"/>
                                    <Button Content="Replace all" Click="ReplaceAll_Click" Padding="8,4"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="ReplaceSimpleRadio" Content="Simple" GroupName="ReplaceMode"
                                                 Foreground="{StaticResource PrimaryText}"/>
                                    <RadioButton x:Name="ReplaceExactRadio" Content="Exact" GroupName="ReplaceMode"
                                                 Foreground="{StaticResource PrimaryText}" Margin="14,0,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="ReplaceStatusText" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

            </StackPanel>

            <!-- Flush against the top and right edges, with no margin of their
                 own: on Windows these run into the corner of the window, and a
                 gap there is the first thing that reads as wrong. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Minimize"/>
                <Button Click="Maximize_Click" Style="{StaticResource MaximizeButtonStyle}"
                        ToolTip="Maximize"/>
                <Button Content="&#xE8BB;" Click="CloseWindow_Click" Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- The path, broken into its parts, under the bar rather than in the
             footer. A path reads better as a trail than as one long string, and
             it belongs at the top beside the thing it names.

             Carried in a ScrollViewer with no visible bar: a path deeper than the
             window is wide gets scrolled to its end after every change, so what
             falls off is the front of the trail and the file's own name is always
             the part still on screen. -->
        <Border Grid.Row="1" Background="{StaticResource WindowBackground}">
            <ScrollViewer x:Name="BreadcrumbScroll" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BreadcrumbBar" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:LineNumberGutter x:Name="LineNumberLayer" Grid.Column="0"
                                    Background="{StaticResource WindowBackground}"
                                    Foreground="{StaticResource SecondaryText}"
                                    DividerBrush="{StaticResource PanelBorder}"
                                    Visibility="Collapsed"/>

            <!-- CanContentScroll puts the view itself in charge of scrolling, which
                 is what lets it report an extent derived from the line count rather
                 than from a measured document. See TextView. -->
            <ScrollViewer x:Name="EditorScroll" Grid.Column="1"
                          CanContentScroll="True"
                          Background="{StaticResource WindowBackground}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <local:TextView x:Name="Editor"
                                FontFamily="{StaticResource AppFont}"
                                FontSize="14"
                                Padding="10,6,10,6"
                                Background="{StaticResource WindowBackground}"
                                Foreground="{StaticResource EditorText}"
                                CaretBrush="{StaticResource EditorText}"
                                SelectionBrush="{StaticResource SelectionBackground}">
                    <local:TextView.ContextMenu>
                        <ContextMenu x:Name="EditorContextMenu" Opened="EditorContextMenu_Opened">
                            <MenuItem x:Name="ContextCut" Header="Cut" Click="ContextCut_Click" InputGestureText="Ctrl+X"/>
                            <MenuItem x:Name="ContextCopy" Header="Copy" Click="ContextCopy_Click" InputGestureText="Ctrl+C"/>
                            <MenuItem x:Name="ContextPaste" Header="Paste" Click="ContextPaste_Click" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem x:Name="ContextSearch" Header="Search term" Click="ContextSearch_Click"/>
                            <MenuItem x:Name="ContextReplace" Header="Replace term" Click="ContextReplace_Click"/>
                        </ContextMenu>
                    </local:TextView.ContextMenu>
                </local:TextView>
            </ScrollViewer>

        </Grid>

        <!-- What is left in the footer is what the path was never really with:
             counts on the left, how the file is written on the right. -->
        <Border Grid.Row="3" Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="ElevationText" Text="Standard" Style="{StaticResource FooterTextStyle}"/>
                <Rectangle Grid.Column="1" Style="{StaticResource FooterSeparatorStyle}"/>
                <TextBlock Grid.Column="2" x:Name="LineCountText" Text="1 ln" Style="{StaticResource FooterTextStyle}"/>
                <Rectangle Grid.Column="3" Style="{StaticResource FooterSeparatorStyle}"/>
                <TextBlock Grid.Column="4" x:Name="CharCountText" Text="0 ch" Style="{StaticResource FooterTextStyle}"/>

                <Rectangle Grid.Column="6" Style="{StaticResource FooterSeparatorStyle}"/>
                <TextBlock Grid.Column="7" x:Name="LineEndingText" Text="CRLF" Style="{StaticResource FooterTextStyle}"/>
                <Rectangle Grid.Column="8" Style="{StaticResource FooterSeparatorStyle}"/>
                <TextBlock Grid.Column="9" x:Name="EncodingText" Text="UTF-8" Style="{StaticResource FooterTextStyle}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
